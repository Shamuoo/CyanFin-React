{
  "name": "cyanfin-react",
  "private": true,
  "version": "0.16.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:build": "electron-builder"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.0.0",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.0",
    "hls.js": "^1.4.0",
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.5.3",
    "vite": "^5.4.0",
    "@tailwindcss/vite": "^4.0.0"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.cyanfin.app",
    "productName": "CyanFin",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/",
      "server/",
      "server/public/",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.svg"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/favicon.svg",
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/favicon.svg",
      "category": "AudioVideo"
    }
  }
}